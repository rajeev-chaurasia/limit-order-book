{
  "name": "limit-order-book",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "25",
      "jdkDistro": "tem",
      "installGradle": false
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "ui/streamlit_app.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "vscjava.vscode-java-pack"
      ]
    }
  },
  "updateContentCommand": "[ -f packages.txt ] && sudo apt update && sudo apt upgrade -y && sudo xargs apt install -y <packages.txt; [ -f ui/requirements.txt ] && pip3 install --user -r ui/requirements.txt; pip3 install --user streamlit; echo 'Packages installed'",
  "postAttachCommand": {
    "server": "streamlit run ui/streamlit_app.py --server.enableCORS false --server.enableXsrfProtection false"
  },
  "portsAttributes": {
    "8080": {
      "label": "Order Book API"
    },
    "8501": {
      "label": "Dashboard",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8080,
    8501
  ]
}
